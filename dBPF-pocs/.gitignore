# --- Build outputs (libbpf-skeleton / CO-RE) ---
# Per-POC and shared build dirs contain everything below; ignore wholesale.
build/
pocs/*/build/
shared/*/build/

# --- BPF / C compilation artifacts ---
*.o
*.bpf.o
*.skel.h         # generated by bpftool gen skeleton
vmlinux.h        # generated by bpftool btf dump; regenerate per-host
*.a
*.d              # compiler dep files

# --- Run logs ---
# Per-chapter run logs at pocs root (ch01.log … ch18.log) are ephemeral
# evidence from run_all.sh. Ignored by default; if you want to keep a
# sample run as reference, commit it explicitly with `git add -f logs/chNN.log`.
logs/
# Stray logs inside build dirs (e.g. cloak-events.log, cloak-stderr.log)
*.log

# --- Python harness ---
__pycache__/
*.pyc
*.pyo

# --- QEMU local disk images (too large for git) ---
# Fetch or build these locally; do not commit.
qemu/*.qcow2
qemu/*.img
qemu/*.raw

# --- OS / editor cruft ---
.DS_Store
*.bak
*.swp
*~
