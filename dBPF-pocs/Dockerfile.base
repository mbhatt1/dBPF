FROM debian:trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      clang llvm lld make gcc binutils \
      libbpf-dev libelf-dev zlib1g-dev \
      bpftool \
      iproute2 iputils-ping net-tools curl ca-certificates \
      kmod procps strace file git pkg-config \
      python3 \
      keyutils libkeyutils-dev libcap2-bin sudo vim-tiny \
    && rm -rf /var/lib/apt/lists/*

# Install libbpf-bootstrap-style helpers (bpf_helpers.h ships with libbpf-dev)
WORKDIR /work
CMD ["/bin/bash"]
